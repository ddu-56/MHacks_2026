# ---------------------------------------------------------------------------
# HoldLess — copy to .env (repo root). Both apps read this one file.
# ---------------------------------------------------------------------------

# Modes
TELEPHONY_MODE=mock            # mock = all simulated · hybrid = simulated company line + real calls to you/rep (Twilio trial OK) · twilio = all real
DEMO_MODE=true                 # short holds, "Run demo" button, deterministic Wolverine Wireless demo

# SpacetimeDB (local: `spacetime start`, then `pnpm stdb:deploy`)
NEXT_PUBLIC_SPACETIMEDB_HOST=ws://127.0.0.1:3000
NEXT_PUBLIC_SPACETIMEDB_MODULE=holdless
SPACETIMEDB_HOST=ws://127.0.0.1:3000
SPACETIMEDB_MODULE=holdless

# Orchestrator HTTP server (Twilio webhooks, media WebSocket, demo IVR)
ORCHESTRATOR_PORT=4000
PUBLIC_BASE_URL=               # public https URL that tunnels to :4000 (ngrok / cloudflared). Required for hybrid and twilio modes.
WEB_BASE_URL=http://localhost:3001

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=           # number HoldLess calls from (E.164, e.g. +17345550100)
TWILIO_VALIDATE_SIGNATURES=false

# Demo: the fake Wolverine Wireless support line
WOLVERINE_IVR_NUMBER=          # twilio mode only: second Twilio number; Voice webhook = POST {PUBLIC_BASE_URL}/ivr/wolverine
DEMO_REP_PHONE_NUMBER=         # teammate playing the representative (blank = scripted rep "Sarah")
USER_PHONE_NUMBER=+14053854093             # default "your phone" for Run demo / iMessage requests
DEMO_HOLD_SECONDS=12
DEMO_HOLD_ANNOUNCEMENT_SECONDS=6

# Google Gemini (IVR reasoning). Blank = deterministic rule-based agent.
GEMINI_API_KEY=
GEMINI_MODEL=                  # optional; auto-picks the newest available Flash model

# ElevenLabs (realtime STT on the support line + TTS for briefings). Blank = Twilio transcription + <Say>.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2_realtime

# Photon Spectrum (iMessage front door). Blank = disabled.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Agent tuning
HUMAN_CONFIDENCE_THRESHOLD=0.8
POSSIBLE_HUMAN_THRESHOLD=0.5
MAX_HOLD_MINUTES=5
USER_ANSWER_TIMEOUT_SECONDS=30

# Email tickets via Resend (resend.com, free tier). Blank = simulated send.
# With the default onboarding@resend.dev sender, Resend only delivers to your Resend account's email,
# so DEMO_INBOX_EMAIL must be that address. Tickets never go to the company address in the form.
RESEND_API_KEY=
DEMO_INBOX_EMAIL=

# Browser agent (Amazon returns) — console at http://localhost:4000/agent
AMAZON_BASE_URL=https://www.amazon.com
BROWSER_PROFILE_DIR=           # blank = backend/orchestrator/.data/chrome-profile (dedicated; never your everyday profile)
BROWSER_CHANNEL=chrome         # uses your installed Google Chrome
BROWSER_HEADLESS=false         # visible window so you can watch, sign in, and approve
BROWSER_USER_WAIT_MINUTES=10   # how long it waits for you to sign in or finish a step

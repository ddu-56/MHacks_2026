{
  "name": "holdless",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --parallel --filter @holdless/web --filter @holdless/orchestrator dev",
    "stdb:start": "spacetime start",
    "stdb:publish": "spacetime publish holdless --module-path backend/spacetimedb --server local --yes",
    "stdb:reset": "spacetime publish holdless --module-path backend/spacetimedb --server local --delete-data=always --yes",
    "stdb:generate": "spacetime generate --lang typescript --out-dir packages/db/src/bindings --module-path backend/spacetimedb --yes",
    "stdb:deploy": "pnpm stdb:publish && pnpm stdb:generate",
    "dev:web": "pnpm --filter @holdless/web dev",
    "dev:orchestrator": "pnpm --filter @holdless/orchestrator dev",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --filter @holdless/shared --filter @holdless/orchestrator test"
  }
}
